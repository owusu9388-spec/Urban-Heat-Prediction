# Copy this file to .env and fill in real values. Never commit .env itself.

# SQLite by default. Swap to a Postgres URL later without changing any code
# (see Section 8.7 Database upgrade path):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./urbanheat.db

# Exact origin of your deployed frontend (no wildcard, no trailing slash).
# During local dev, match whatever you serve the frontend on.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500

