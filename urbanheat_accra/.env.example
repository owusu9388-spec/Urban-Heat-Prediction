# Copy this file to .env and adjust for your environment.
# Never commit the real .env file.

# Comma-separated list of allowed frontend origins for CORS.
# Do NOT use "*" in production.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# SQLAlchemy database URL. SQLite by default (single file, zero external
# service). Swap to a managed Postgres URL when scaling beyond the MVP.
DATABASE_URL=sqlite:///./data/urbanheat.db

# Path to the trained model file, loaded once at startup.
MODEL_PATH=./models/heat_risk_model.pkl

# Set to "true" to enable debug behaviour (currently unused, reserved).
DEBUG=false
